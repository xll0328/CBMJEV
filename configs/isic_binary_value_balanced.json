{
  "schema_version": "cbmjev-config-v1",
  "seed": 17,
  "device": "cuda:0",
  "learning": {
    "objective": "value",
    "hidden": 128,
    "head_epochs": 40,
    "policy_epochs": 40,
    "batch_size": 64,
    "learning_rate": 0.001,
    "masks_per_sample": 8,
    "include_pairs": true,
    "include_all": true,
    "max_pair_actions": 8,
    "actions_per_state": 64,
    "class_weighting": "inverse_frequency"
  },
  "policy": {
    "cost_weight": 0.03,
    "max_groups": 5,
    "max_cost": null
  },
  "cost": {
    "setup": 0.0,
    "call": 0.0,
    "per_group": 1.0,
    "units": "declared_query_units"
  },
  "evaluation": {
    "methods": ["stop", "all", "fixed", "random", "static", "value"],
    "bootstrap_resamples": 1000,
    "lookahead_depth": 2
  }
}
